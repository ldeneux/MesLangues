# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # jamais exposée au client, utilisée dans les routes serveur

# Génération des phrases et des tests (Gemini, gratuit)
# Clé sans carte bancaire sur https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Google Cloud Text-to-Speech
# Console Google Cloud > APIs & Services > Identifiants > Créer une clé API,
# puis restreindre cette clé à l'API "Cloud Text-to-Speech API" uniquement.
# ⚠️ N'oublie pas de poser un quota journalier (voir README, section 3) —
# c'est ce qui te protège d'une facturation inattendue, pas le budget alert.
GOOGLE_TTS_API_KEY=AIza...

# Sécurise l'appel du cron quotidien (Vercel Cron envoie ce header)
CRON_SECRET=change-moi

# Schéma PostgreSQL des tables de l'appli : « public » (défaut) ou « langues » après la migration 025
# (voir supabase/schema_langues/LISEZ-MOI.md). Après changement : redéployer.
# NEXT_PUBLIC_DB_SCHEMA=langues

# Stockage des audios sur Cloudflare R2 (optionnel : sans ces 5 variables, les audios restent dans Supabase Storage).
# Voir LISEZ-MOI-R2.md. Ne mets JAMAIS la clé secrète dans le dépôt ni dans un message : seulement ici et dans Vercel.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meslangues-audio
R2_PUBLIC_BASE_URL=https://audio.exemple.com        # adresse publique du bucket, sans « / » final

# Génération automatique des planches d'images (onglet Packs > Images manquantes) : API OpenAI, modèle gpt-image-1-mini, qualité medium
# (≈ 0,015 $ la planche de 20 images). Clé sur https://platform.openai.com/api-keys ; pose une limite de dépense mensuelle sur ton compte OpenAI.
OPENAI_API_KEY=sk-...
# Facultatif : autre modèle d'image (gpt-image-1-mini sera retiré de l'API le 1er décembre 2026 selon OpenAI) — ex. gpt-image-2
# OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Images des mots sur Cloudflare R2 (voir LISEZ-MOI-IMAGES-R2.md). À définir APRÈS avoir copié les images (bloc « Images des mots sur Cloudflare R2 »),
# puis redéployer. Adresse publique du bucket + /images, sans « / » final. Sans cette variable, l'appli lit public/image_webp.
# NEXT_PUBLIC_IMAGE_BASE_URL=https://pub-xxxx.r2.dev/images
